# Public URL only. Never put Google, SMS, Fayda, payment, or database secrets in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
# Hosted preview/production value:
# https://uikwhmkkfidckcejllrk.supabase.co/functions/v1/api
# Public HTTPS address of the Konjo web app, used for shareable profile links
# (https://<host>/professional/<id>). Leave empty to share the app deep link instead.
EXPO_PUBLIC_WEB_URL=
# Support contact shown in both apps (Help & support, Report a safety issue).
EXPO_PUBLIC_SUPPORT_EMAIL=Info@Konjo.com
EXPO_PUBLIC_SUPPORT_PHONE=

# Supabase client settings. The publishable key is intended for client apps;
# never use the service-role secret in an EXPO_PUBLIC_* variable.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_AUTH_PROVIDER=api
# Where Supabase sends clients after they open an email link. Native builds use
# the app scheme; the web app automatically uses its own origin instead. Every
# value here must also be listed under Authentication → URL Configuration →
# Redirect URLs in the Supabase dashboard (see SUPABASE_SETUP.md).
EXPO_PUBLIC_PASSWORD_RESET_REDIRECT_URL=konjoclient://client-email?mode=reset
EXPO_PUBLIC_PROFESSIONAL_PASSWORD_RESET_REDIRECT_URL=
EXPO_PUBLIC_PROFESSIONAL_EMAIL_CONFIRM_REDIRECT_URL=
EXPO_PUBLIC_EMAIL_CONFIRM_REDIRECT_URL=konjoclient://client-email?mode=confirm

# Account-owned native identifiers; configure the same values in EAS environments.
KONJO_EAS_PROJECT_ID=
KONJO_ANDROID_PACKAGE=
KONJO_IOS_BUNDLE_IDENTIFIER=
# Local path to the public Android Firebase configuration. Store the same file
# in EAS as a file variable for development, preview and production builds.
# Keep the file out of git even though it is not the Firebase private key.
GOOGLE_SERVICES_JSON=./google-services.json

# Applied at build time: after setting it run `npx expo prebuild --clean` and
# `npx expo run:android`. Without it the app draws the OpenStreetMap map below.
# In-app map: CARTO Voyager vector basemap (OpenStreetMap data) rendered by MapLibre.
# Get a CARTO Basemaps key at carto.com/basemaps/apikey. It ships inside the app, so restrict
# it to the app in the CARTO dashboard. Attribution "© OpenStreetMap contributors, © CARTO" is
# always shown. The map shows an error state when no key is configured (no public OSM tiles).
CARTO_BASEMAPS_API_KEY=
# Optional: another MapLibre style URL (for example a self-hosted style) instead of CARTO Voyager.
EXPO_PUBLIC_MAP_STYLE_URL=

# Explicit deployment mode. Use `preview` for a hosted test build or
# `production` to enforce live credentials, HTTPS URLs, and no mock OTP.
# When unset, NODE_ENV=production still enables all production safeguards.
KONJO_ENVIRONMENT=
# Reverse-proxy hops in front of the API (0 = clients connect directly). Needed
# for correct per-client rate limiting behind a load balancer.
KONJO_TRUSTED_PROXY_HOPS=0
# Per-address budget for sign-in, OTP and password-reset attempts.
KONJO_AUTH_RATE_LIMIT_PER_MINUTE=30

# Backend-only local development settings.
KONJO_API_HOST=127.0.0.1
KONJO_API_PORT=4000
KONJO_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082
KONJO_DATABASE_PATH=backend/data/konjo.db
# Local-mode storage for CV and portfolio uploads received by the public website.
# Provider mode uses the private Supabase website-professional-applications bucket.
KONJO_APPLICATION_UPLOAD_PATH=backend/data/applications
KONJO_CONTACT_EMAIL=Info@Konjoet.com
KONJO_CAREERS_EMAIL=hr@Konjo.etcom
KONJO_FOUNDER_EMAIL=hanna@Konjoet.com
# Optional email delivery for website forms. Without these values, submissions
# remain safely stored in the backend for review and the API still acknowledges them.
KONJO_RESEND_API_KEY=
KONJO_EMAIL_FROM=
KONJO_SESSION_DAYS=30
KONJO_AUTH_MODE=development
KONJO_AUTH_PEPPER=replace-with-a-long-random-production-secret
KONJO_OTP_DELIVERY_URL=
KONJO_OTP_DELIVERY_TOKEN=
KONJO_EMAIL_DELIVERY_URL=
KONJO_EMAIL_DELIVERY_TOKEN=
KONJO_FAYDA_VERIFICATION_URL=
KONJO_FAYDA_VERIFICATION_TOKEN=
KONJO_PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Chapa API v2 keys (dashboard.chapa.global → Settings → API keys). All three
# must be set together. Test keys start with CHAPA_TEST_, live keys with
# CHAPA_LIVE_; the same host serves both and the key decides the mode. Paste the
# bare key values (no labels such as "-secret" appended).
# Leave all empty in development mode — a deterministic sandbox is used instead.
KONJO_CHAPA_SECRET_KEY=
# Publishable key — safe to expose to the client app.
KONJO_CHAPA_PUBLIC_KEY=
# Encryption key — server-side only, never put in an EXPO_PUBLIC_* variable.
KONJO_CHAPA_ENCRYPTION_KEY=
# Public origins written into links handed to clients. The API URL is used for
# provider webhooks and the local sandbox checkout page; the web URL is where a
# hosted checkout returns the client afterwards.
KONJO_PUBLIC_API_URL=http://127.0.0.1:4000
KONJO_PUBLIC_WEB_URL=http://localhost:8081
# Serves a local "Confirm payment" page for sandbox intents so bookings can be
# paid end to end without a Chapa key. On by default in development mode; set
# to true explicitly in provider mode while testing. Never enable in production.
KONJO_PAYMENT_SANDBOX_CHECKOUT=false
# Optional Expo access token for enhanced push security (Expo dashboard → Account Settings → Access Tokens).
# Without it push works, but any party with your Expo project ID can deliver notifications to your users.
# Get yours at: https://expo.dev/accounts/[account]/settings/access-tokens
EXPO_ACCESS_TOKEN=
KONJO_NOTIFICATION_DELIVERY_URL=
KONJO_NOTIFICATION_DELIVERY_TOKEN=
# Used by the backend notification adapter for approval and operational SMS.
SMSETHIOPIA_API_KEY=
# Temporary local-only professional registration code. The API refuses this
# bypass in production. Keep both flags false when real SMS is connected.
KONJO_ENABLE_PROFESSIONAL_MOCK_OTP=false
EXPO_PUBLIC_ENABLE_PROFESSIONAL_MOCK_OTP=false
# At least 32 random characters. A managed scheduler sends this only to the backend.
KONJO_WORKER_TOKEN=
KONJO_LOG_LEVEL=info
KONJO_ADMIN_EMAIL=admin@konjo.local
KONJO_ADMIN_PASSWORD=replace-this-development-only-password
KONJO_PASSWORD_RESET_URL=http://localhost:8081/client-email?mode=reset
KONJO_SUPABASE_URL=
KONJO_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose this as an EXPO_PUBLIC or NEXT_PUBLIC variable.
KONJO_SUPABASE_SECRET_KEY=
# Alternatively, the backend accepts the existing server-only SUPABASE_SERVICE_ROLE_KEY.
# Never prefix a service-role/secret key with EXPO_PUBLIC_.

# Supabase Edge Function secrets for the Send SMS Auth Hook. Set these with
# `supabase secrets set`; never expose them through EXPO_PUBLIC_* variables.
SEND_SMS_HOOK_SECRET=

# Set to false when an external scheduler calls /v1/internal/jobs/run.
KONJO_IN_PROCESS_JOBS=true
